{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build only",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\src\\BizHawkPSXMMX.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "BizHawk: Deploy",
      "type": "process",
      "command": "dotnet",
      "args": [
        "msbuild",
        "${workspaceFolder}\\src\\BizHawkPSXMMX.csproj",
        "-restore",
        "-target:DeployToBizHawk"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build, Deploy and Launch",
      "type": "process",
      "command": "dotnet",
      "args": [
        "msbuild",
        "${workspaceFolder}\\src\\BizHawkPSXMMX.csproj",
        "-restore",
        "-target:LaunchBizHawk",
        "-property:RomPath=${input:romPath}"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "romPath",
      "type": "promptString",
      "description": "Optional full path to the ROM to open; leave blank to start without one",
      "default": ""
    }
  ]
}
