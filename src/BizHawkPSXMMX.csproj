<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>

    <!-- Target BizHawk environment settings -->
    <BizHawk_Version>2.11.1</BizHawk_Version>
    <BizHawk_Home Condition="'$(BizHawk_Home)' == ''">$(MSBuildProjectDirectory)\..\..\$(BizHawk_Version)\</BizHawk_Home>
    <BizHawk_DLL>$(BizHawk_Home)dll\</BizHawk_DLL>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="System.Windows.Forms" />
    <Reference Include="BizHawk.Client.Common" HintPath="$(BizHawk_DLL)BizHawk.Client.Common.dll" />
    <Reference Include="BizHawk.Client.EmuHawk" HintPath="$(BizHawk_Home)EmuHawk.exe" />
    <Reference Include="BizHawk.Common" HintPath="$(BizHawk_DLL)BizHawk.Common.dll" />
    <Reference Include="BizHawk.Emulation.Common" HintPath="$(BizHawk_DLL)BizHawk.Emulation.Common.dll" />
    <Reference Include="BizHawk.WinForms.Controls" HintPath="$(BizHawk_DLL)BizHawk.WinForms.Controls.dll" />
    
    <EmbeddedResource Include="Icon.ico" />
  </ItemGroup>

  <Target Name="DeployToBizHawk" DependsOnTargets="Build">
    <Error
      Condition="!Exists('$(BizHawk_Home)EmuHawk.exe')"
      Text="BizHawk was not found at '$(BizHawk_Home)'. Set the BizHawk_Home MSBuild property to the installation directory." />
    <MakeDir Directories="$(BizHawk_Home)ExternalTools" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(BizHawk_Home)ExternalTools"
      Retries="3"
      RetryDelayMilliseconds="300" />
  </Target>

  <Target Name="LaunchBizHawk" DependsOnTargets="DeployToBizHawk">
    <Error
      Condition="'$(RomPath)' != '' and !Exists('$(RomPath)')"
      Text="The ROM specified by RomPath was not found: '$(RomPath)'." />
    <Exec
      Condition="'$(RomPath)' != ''"
      Command="start &quot;&quot; &quot;$(BizHawk_Home)EmuHawk.exe&quot; --open-ext-tool-dll=$(AssemblyName) &quot;$(RomPath)&quot;" />
    <Exec
      Condition="'$(RomPath)' == ''"
      Command="start &quot;&quot; &quot;$(BizHawk_Home)EmuHawk.exe&quot; --open-ext-tool-dll=$(AssemblyName)" />
  </Target>

</Project>